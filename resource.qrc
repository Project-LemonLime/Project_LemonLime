<RCC>
    <qresource prefix="/logo">
        <file alias="splash2.png">assets/pics/splash2.png</file>
    </qresource>
    <qresource prefix="/asset">
        <file>makespec/VERSION</file>
        <file>makespec/VERSIONSUFFIX</file>
        <file>assets/lemon-lime.ico</file>
    </qresource>
    <qresource prefix="/icon">
        <file alias="icon.png">assets/icons/lemon-lime.png</file>
        <file alias="code-function.llsvg">assets/pics/code-function.svg</file>
        <file alias="configure.llsvg">assets/pics/configure.svg</file>
        <file alias="dialog-cancel.llsvg">assets/pics/dialog-cancel.svg</file>
        <file alias="dialog-ok-apply.llsvg">assets/pics/dialog-ok-apply.svg</file>
        <file alias="document-edit.llsvg">assets/pics/document-edit.svg</file>
        <file alias="edit-clear.llsvg">assets/pics/edit-clear.svg</file>
        <file alias="edit-delete.llsvg">assets/pics/edit-delete.svg</file>
        <file alias="edit-find-replace.llsvg">assets/pics/edit-find-replace.svg</file>
        <file alias="edit-find.llsvg">assets/pics/edit-find.svg</file>
        <file alias="go-down.llsvg">assets/pics/go-down.svg</file>
        <file alias="go-up.llsvg">assets/pics/go-up.svg</file>
        <file alias="list-add.llsvg">assets/pics/list-add.svg</file>
        <file alias="list-remove.llsvg">assets/pics/list-remove.svg</file>
        <file alias="media-playback-stop.llsvg">assets/pics/media-playback-stop.svg</file>
        <file alias="media-skip-forward.llsvg">assets/pics/media-skip-forward.svg</file>
        <file alias="paint-none.llsvg">assets/pics/paint-none.svg</file>
        <file alias="view-refresh.llsvg">assets/pics/view-refresh.svg</file>
        <file alias="view-sort.llsvg">assets/pics/view-sort.svg</file>
        <file alias="application-exit.llsvg">assets/pics/application-exit.svg</file>
        <file alias="deletecell.llsvg">assets/pics/deletecell.svg</file>
        <file alias="document-close.llsvg">assets/pics/document-close.svg</file>
        <file alias="document-export.llsvg">assets/pics/document-export.svg</file>
        <file alias="document-new.llsvg">assets/pics/document-new.svg</file>
        <file alias="document-save.llsvg">assets/pics/document-save.svg</file>
        <file alias="globe.llsvg">assets/pics/globe.svg</file>
        <file alias="go-parent-folder.llsvg">assets/pics/go-parent-folder.svg</file>
        <file alias="help-about.llsvg">assets/pics/help-about.svg</file>
